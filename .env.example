# Copy this file to ".env" (same folder as manage.py) and fill it in.
# The .env file holds secrets: never share it and never upload it to GitHub.

# On your own computer use 1. On the live website it must be 0.
DJANGO_DEBUG=1

# A long random string. Make one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Website addresses, separated by commas, no spaces and no https://
# Local:        localhost,127.0.0.1
# Live example: yourname.pythonanywhere.com   or   www.yourdomain.com,yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Live site only: the full addresses WITH https://, separated by commas
# Example: https://yourname.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional: change the admin address from /admin/ to something only you know
# Do NOT use manage/ here: that address belongs to Boski's dashboard.
# Example: DJANGO_ADMIN_URL=boski-manage/
DJANGO_ADMIN_URL=admin/

# Live site. Leave these as they are unless HOSTING_GUIDE.md tells you to change them.
# 1 = login and preorder-list cookies are only sent over HTTPS (needs the https:// address)
DJANGO_SECURE_COOKIES=1
# 0 = let the host redirect http to https (recommended). Only use 1 if the guide says so.
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0

# Defaults used until you save "Store settings" in the admin
STORE_NAME=Boski
STORE_WHATSAPP_NUMBER=8613250576403
STORE_WHATSAPP_DISPLAY=+86 132 5057 6403
